{
  "name": "career-ops",
  "version": "1.10.0",
  "description": "AI-powered job search pipeline — works with any AI coding CLI (Claude Code, OpenCode, Gemini, Codex, Qwen)",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node updater-migration-tests.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "validate:portals": "node validate-portals.mjs",
    "tracker": "node tracker.mjs",
    "patterns": "node analyze-patterns.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "web:dev": "npm run dev --workspace @career-navigator/web",
    "web:build": "npm run build --workspace @career-navigator/web",
    "web:typecheck": "npm run typecheck --workspace @career-navigator/web",
    "web:e2e": "node tests/e2e/tailoring-demo-flow.mjs",
    "web:e2e:headed": "node tests/e2e/tailoring-demo-flow.mjs --headed",
    "web:e2e:import": "node tests/e2e/resume-file-import-flow.mjs",
    "web:e2e:import:headed": "node tests/e2e/resume-file-import-flow.mjs --headed",
    "web:e2e:structure": "node tests/e2e/structured-resume-flow.mjs",
    "web:e2e:structure:headed": "node tests/e2e/structured-resume-flow.mjs --headed",
    "web:e2e:targeting": "node tests/e2e/structured-targeting-flow.mjs",
    "web:e2e:targeting:headed": "node tests/e2e/structured-targeting-flow.mjs --headed",
    "web:e2e:rc": "node tests/e2e/release-candidate-flow.mjs",
    "web:e2e:rc:headed": "node tests/e2e/release-candidate-flow.mjs --headed",
    "web:build:pages": "node tests/release/run-with-pages-base.mjs web:build",
    "web:e2e:pages": "node tests/release/run-pages-e2e.mjs",
    "web:bundle:check": "node tests/release/web-bundle-budget.mjs",
    "web:pages:artifact-check": "node tests/release/pages-artifact-check.mjs",
    "web:pages:smoke": "node tests/release/github-pages-smoke.mjs",
    "release:check": "node tests/release/release-check.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "docx": "9.7.1",
    "dotenv": "^17.0.0",
    "js-yaml": "4.3.0",
    "jszip": "3.10.1",
    "playwright": "1.58.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0",
    "vitest": "^0.34.0",
    "zod": "^3.22.2"
  }
}
